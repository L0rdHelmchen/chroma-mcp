# AWS-Specific Environment Configuration für Enhanced Chroma MCP Server
# Kopiere diese Datei auf deinen AWS Server und passe sie an

# ======================
# Chroma Connection Settings
# ======================
CHROMA_CLIENT_TYPE=http
CHROMA_HOST=chromaDb  # ⚠️  Adjust: Chroma DB Host-Adresse
CHROMA_PORT=8000
CHROMA_SSL=false      

# ======================
# Enhanced Connectivity Settings (NEW)
# ======================
CHROMA_DEBUG=true                           # Detaillierte Logs für initiales Debugging
CHROMA_CONNECTION_TIMEOUT=60                # Längere Timeouts für AWS-Latenz
CHROMA_RETRY_ATTEMPTS=5                     # Mehr Retries für AWS-Netzwerk
CHROMA_DOTENV_PATH=/app/.chroma_env         # Container-interner Pfad

# ======================
# AWS-Specific Settings
# ======================
AWS_REGION=eu-central-1                        # ⚠️  Adjust: AWS Region
AWS_DEFAULT_REGION=us-east-1

# CloudWatch Logging
DOCKER_LOGGING_DRIVER=awslogs
DOCKER_LOGGING_OPTIONS=awslogs-group=/aws/docker/chroma-mcp,awslogs-region=eu-central-1

# ======================
# Embedding Function API Keys (Optional)
# ======================
# Wenn du externe Embedding Functions nutzt:
# CHROMA_OPENAI_API_KEY=sk-...
# CHROMA_COHERE_API_KEY=...
# CHROMA_JINA_API_KEY=...
# CHROMA_VOYAGEAI_API_KEY=...

# ======================
# Security & Performance
# ======================
# Container Memory Limits (falls benötigt)
MEMORY_LIMIT=1g
CPU_LIMIT=1.0

# Health Check Settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ======================
# Troubleshooting Configurations
# ======================
# Bei Connectivity-Problemen, versuche diese Settings:

# Für DNS-Probleme:
# CHROMA_HOST=10.0.1.100                   # Direkte IP statt DNS

# Für SSL-Probleme:
# CHROMA_SSL=false                          # SSL deaktivieren für Debugging

# Für Timeout-Probleme:
# CHROMA_CONNECTION_TIMEOUT=120             # Noch längere Timeouts
# CHROMA_RETRY_ATTEMPTS=10                  # Mehr Retry-Versuche

# Für Network-Debugging:
# CHROMA_DEBUG=true                         # Aktiviert verbose logging
# DOCKER_NETWORK_MODE=host                  # Host-Network-Modus (weniger Isolation)

# ======================
# Deployment Automation
# ======================
# Für automatische Deployments:
DEPLOYMENT_STRATEGY=rolling                 # rolling, blue-green, recreate
BACKUP_RETENTION_DAYS=7                     # Wie lange Backups aufbewahren
AUTO_ROLLBACK=true                          # Automatisches Rollback bei Fehlern

# ======================
# Monitoring & Alerting
# ======================
# Für CloudWatch/Monitoring Integration:
METRICS_ENABLED=true
LOG_LEVEL=INFO                              # INFO, DEBUG, WARNING, ERROR
HEALTH_CHECK_ENDPOINT=/health               # Falls HTTP Health Check verfügbar


# ======================
# Load Balancer Integration (Optional)
# ======================
# Falls du einen ALB/NLB vor deinem Container hast:
# LOAD_BALANCER_HEALTH_CHECK_PATH=/api/v1/heartbeat
# LOAD_BALANCER_PORT=8080
# STICKY_SESSIONS=false

# ======================
# Development vs. Production
# ======================
# Für Development:
# CHROMA_DEBUG=true
# CHROMA_CONNECTION_TIMEOUT=30
# CHROMA_RETRY_ATTEMPTS=3
# LOG_LEVEL=DEBUG

# Für Production:
# CHROMA_DEBUG=false
# CHROMA_CONNECTION_TIMEOUT=60
# CHROMA_RETRY_ATTEMPTS=5
# LOG_LEVEL=INFO